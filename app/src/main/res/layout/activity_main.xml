<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="#212121">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Car Lyric Controller"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnStartService"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Start Overlay"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle" />

    <Button
        android:id="@+id/btnStopService"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Stop Overlay"
        android:backgroundTint="#D32F2F"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toEndOf="@+id/btnStartService"
        app:layout_constraintTop_toTopOf="@+id/btnStartService" />

    <Switch
        android:id="@+id/switchLockPosition"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lock Position"
        android:textColor="#FFFFFF"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnStartService" />

    <Switch
        android:id="@+id/switchShowLyrics"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Show/Hide"
        android:checked="true"
        android:textColor="#FFFFFF"
        android:layout_marginStart="24dp"
        app:layout_constraintStart_toEndOf="@+id/switchLockPosition"
        app:layout_constraintTop_toTopOf="@+id/switchLockPosition" />

    <TextView
        android:id="@+id/tvSizeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Text Size"
        android:textColor="#CCCCCC"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/switchLockPosition" />

    <SeekBar
        android:id="@+id/seekBarSize"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:max="40"
        android:progress="18"
        android:min="10"
        app:layout_constraintStart_toEndOf="@+id/tvSizeLabel"
        app:layout_constraintTop_toTopOf="@+id/tvSizeLabel"
        app:layout_constraintBottom_toBottomOf="@+id/tvSizeLabel"
        android:layout_marginStart="16dp"/>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Status: Ready"
        android:textColor="#AAAAAA"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>